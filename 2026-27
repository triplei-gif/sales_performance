      const p = bt.pct;
      const bw = Math.min(100, Math.max(0, p||0));
      return `<tr>
        <td class="batch-name">${bt.name}</td>
        <td class="num">${fmtNum(bt.target)}</td>
        <td class="num">${fmtNum(bt.actual)}</td>
        <td class="pct">
          <div class="pct-bar-wrap">
            <div class="mini-bar"><div class="mini-bar-fill" style="width:${bw}%;background:${barColor(p)}"></div></div>
            <span class="pct-badge ${pctColor(p)}" style="min-width:50px">${pctText(p)}</span>
          </div>
        </td>
        <td class="sf">${fmtNum(bt.sf)}</td>
        <td class="num">${fmtNum(bt.leads)}</td>
      </tr>`;
    }).join('') : `<tr><td colspan="6" class="no-batches">No batch breakdown available</td></tr>`;

    return `<div class="course-section" id="course-${ci}">
      <div class="course-header" onclick="toggleCourse(${ci})">
        <div class="course-name">${c.name}</div>
        <div class="course-stats">
          <div class="stat-chip"><div class="val">${c.target}</div><div class="lbl">Target</div></div>
          <div class="stat-chip"><div class="val">${c.actual}</div><div class="lbl">Actual</div></div>
          <div class="stat-chip"><div class="val">${c.sf}</div><div class="lbl">SF</div></div>
          <div class="stat-chip"><div class="val">${c.leads}</div><div class="lbl">Leads</div></div>
          <span class="pct-badge ${pctColor(c.pct)}">${pctText(c.pct)}</span>
          <span class="toggle-icon">▼</span>
        </div>
      </div>
      <div class="batch-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Batch</th><th class="right">Target</th><th class="right">Actual</th>
              <th class="right">Achievement</th><th class="right">Seats Free</th><th class="right">Leads</th>
            </tr>
          </thead>
          <tbody>${batchRows}</tbody>
        </table>
      </div>
    </div>`;
  }).join('');
}

function renderSummary() {
  const b = branches[activeBranch];
  const t = b.total;
  const pct = t.pct;
  const col = pct >= 80 ? 'var(--green)' : pct >= 50 ? 'var(--yellow)' : 'var(--red)';
  document.getElementById('summaryBar').innerHTML = `
    <div>
      <div class="summary-label">Branch Total</div>
      <div class="summary-val" style="color:${b.color}">${b.label}</div>
    </div>
    <div>
      <div class="summary-label">Target</div>
      <div class="summary-val">${t.target}</div>
    </div>
    <div>
      <div class="summary-label">Actual</div>
      <div class="summary-val">${t.actual}</div>
    </div>
    <div>
      <div class="summary-label">Overall %</div>
      <div class="summary-val" style="color:${col}">${pctText(pct)}</div>
    </div>
    <div>
      <div class="summary-label">Seats Free</div>
      <div class="summary-val">${t.sf}</div>
    </div>
    <div>
      <div class="summary-label">Leads</div>
      <div class="summary-val">${t.leads}</div>
    </div>`;
}

function render() {
  renderTabs();
  renderKPI();
  renderCourses();
  renderSummary();
}

function switchBranch(key) {
  activeBranch = key;
  render();
}

function toggleCourse(ci) {
  const el = document.getElementById('course-'+ci);
  el.classList.toggle('open');
}

render();
</script>
</body>
</html>
