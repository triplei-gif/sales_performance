// ===================== RENDER =====================
function pctColor(p) {
  if (p === null || p === undefined) return 'bg-grey';
  if (p >= 80) return 'bg-green';
  if (p >= 50) return 'bg-yellow';
  return 'bg-red';
}
function pctText(p) {
  if (p === null || p === undefined) return '—';
  return p + '%';
}
function fmtNum(n) { return (n === null || n === undefined) ? '—' : n; }

function barColor(p) {
  if (!p || p <= 0) return '#fed7d7';
  if (p >= 80) return '#48bb78';
  if (p >= 50) return '#ecc94b';
  return '#fc8181';
}

