  ).join('');
}

function renderKPI() {
  const b = branches[activeBranch];
  const t = b.total;
  const color = b.color;
  const kpis = [
    { label:'Target', value: t.target, sub:'Seats planned' },
    { label:'Actual', value: t.actual, sub:'Enrolled' },
    { label:'Achievement', value: pctText(t.pct), sub:'Conversion rate' },
    { label:'Seats Free', value: t.sf, sub:'Remaining capacity' },
    { label:'Leads', value: t.leads, sub:'Prospects tracked' },
  ];
  document.getElementById('kpiRow').innerHTML = kpis.map((k,i) =>
    `<div class="kpi-card" style="border-top:3px solid ${i===2?color:'var(--border)'}">
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value" style="${i===2?'color:'+color:''}">${k.value}</div>
      <div class="kpi-sub">${k.sub}</div>
    </div>`
  ).join('');
}

